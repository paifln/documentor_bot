# ============================================================
# AI CourseWork Checker — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:REPLACE_WITH_REAL_TOKEN
ADMIN_IDS=111111111,222222222

# --- Database ---
# Local dev (SQLite, no server needed):
DATABASE_URL=sqlite+aiosqlite:///./data/coursework_checker.db
# Production (PostgreSQL, used by docker-compose):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/coursework_checker

# --- Redis (task queue / cache) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM provider ---
# Supported: openai | anthropic | google | local | mock
LLM_PROVIDER=openai
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Limits ---
MAX_FILE_SIZE_MB=20
MAX_PAGES=100
MAX_AI_TOKENS_PER_CHECK=60000
MAX_CHECKS_PER_DAY=20
FILE_RETENTION_HOURS=24

# --- Storage ---
STORAGE_DIR=./data/storage
REPORTS_DIR=./data/reports

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_RULE_PRESET=makhambet_coursework
